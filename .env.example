# Database — SQLite for local dev (file is created by `bun run db:push`)
# Note: relative SQLite paths resolve relative to the prisma/ directory.
DATABASE_URL=file:./db/custom.db

# For production, swap to PostgreSQL:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/mindspace
# (and change provider to "postgresql" in prisma/schema.prisma)

# NextAuth — generate your own secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional — add real credentials to enable Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Multi-Language Code Execution Sandbox (Piston)
# Defaults to self-hosted Piston container on port 2000
PISTON_API_URL=http://localhost:2000/api/v2
